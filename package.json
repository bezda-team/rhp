{
  "name": "@bezda/rhp",
  "version": "2.0.0",
  "description": "rhp (reactive html plots): plots as stacks of slats, built with SolidJS, HTML and CSS",
  "keywords": [
    "solid",
    "solidjs",
    "plots",
    "charts",
    "html",
    "css",
    "reactive"
  ],
  "author": {
    "name": "Bouzid Anas",
    "email": "anas.bouzid@bezda.net"
  },
  "license": "MIT",
  "homepage": "https://rhp.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/bezda-team/rhp"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "worker": "./dist/server.js",
      "browser": "./dist/index.js",
      "deno": "./dist/server.js",
      "node": "./dist/server.js",
      "default": "./dist/index.js"
    },
    "./standalone": "./dist/standalone.js"
  },
  "module": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "gallery": "node examples/gallery/make.mjs",
    "test": "node test/run.mjs",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "babel-preset-solid": "^1.9.15",
    "esbuild": "^0.25.12",
    "playwright": "^1.56.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "solid-js": "^1.9.15"
  }
}
