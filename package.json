{
  "name": "@bezda/rhp",
  "version": "2.0.2",
  "description": "rhp (reactive html plots): plots as stacks of slats, built with SolidJS out of HTML elements and CSS",
  "keywords": [
    "solid",
    "solidjs",
    "plots",
    "charts",
    "html",
    "css",
    "reactive"
  ],
  "author": {
    "name": "Bouzid Anas",
    "email": "anas.bouzid@bezda.net"
  },
  "license": "MIT",
  "homepage": "https://rhp.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/bezda-team/rhp"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "solid": "./dist/source/index.js",
      "worker": "./dist/server.js",
      "browser": "./dist/index.js",
      "deno": "./dist/server.js",
      "node": "./dist/server.js",
      "default": "./dist/index.js"
    },
    "./standalone": {
      "types": "./dist/standalone.d.ts",
      "default": "./dist/standalone.js"
    },
    "./rhp.css": "./dist/rhp.css",
    "./posters.css": "./dist/posters.css"
  },
  "module": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "gallery": "node examples/gallery/make.mjs",
    "test": "node test/style-string-run.mjs && node test/comparison-regressions.mjs && node test/manydots-run.mjs && node test/run.mjs",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/react": "^19.3.0",
    "babel-preset-solid": "^1.9.15",
    "esbuild": "^0.28.2",
    "playwright": "^1.56.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "solid-js": "^1.9.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vite-plugin-solid": "^2.11.14"
  }
}
