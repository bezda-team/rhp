  "adapter_before": "// rhp: a scatter plot is an overlap Plot of one slat per point, each a Dot; a line is one Line block (an SVG path).\n// Both static, as rhp's docs say for a chart whose data never changes.\nimport { render } from \"solid-js/web\";\nimport { Chart, Plot, Dot, Line, slat } from \"../../src/index.js\";\nconst Point = slat({}, (d) => <div><Dot at={d.x} cross={d.y} size=\"4px\" /></div>);\nconst Curve = slat({}, (d) => <div><Line points={d.points} /></div>);\nexport default {\n  name: \"rhp\",\n  scatter: (el, pts) => render(() => (\n    <Chart scale={[0, 100]} cross={[0, 100]} height={400} static={true}><Plot overlap={true} rows={pts}>{Point}</Plot></Chart>\n  ), el),\n  line: (el, pts) => render(() => (\n    <Chart scale={[0, pts.length - 1]} cross={[-2, 2]} height={400} static={true}><Plot overlap={true} points={[pts.map((p) => [p.x, p.y])]}>{Curve}</Plot></Chart>\n  ), el),\n};\n",
  "adapter_after": "// rhp: a scatter plot is an overlap Plot of one slat per point, each a Dot; a line is one Line block (an SVG path).\n// Both static, as rhp's docs say for a chart whose data never changes.\nimport { render } from \"solid-js/web\";\nimport { Chart, Plot, Dot, Line, slat } from \"../../src/index.js\";\nconst Point = slat({}, (d) => <Dot at={d.x} cross={d.y} size=\"4px\" />);\nconst Curve = slat({}, (d) => <div><Line points={d.points} /></div>);\nexport default {\n  name: \"rhp\",\n  scatter: (el, pts) => render(() => (\n    <Chart scale={[0, 100]} cross={[0, 100]} height={400} static={true}><Plot overlap={true} rows={pts}>{Point}</Plot></Chart>\n  ), el),\n  line: (el, pts) => render(() => (\n    <Chart scale={[0, pts.length - 1]} cross={[-2, 2]} height={400} static={true}><Plot overlap={true} points={[pts.map((p) => [p.x, p.y])]}>{Curve}</Plot></Chart>\n  ), el),\n};\n",
