{
  "name": "@bezda/rhp-react",
  "version": "3.0.0",
  "description": "rhp (reactive html plots) for React: plots as stacks of slats, built with React out of HTML elements and CSS",
  "keywords": [
    "react",
    "charts",
    "plots",
    "html",
    "css",
    "reactive"
  ],
  "author": {
    "name": "Bouzid Anas",
    "email": "anas.bouzid@bezda.net"
  },
  "license": "MIT",
  "homepage": "https://rhp.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/bezda-team/rhp",
    "directory": "react"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./dist/index.js"
    },
    "./rhp.css": "./dist/rhp.css",
    "./rhp-no-css-guard.css": "./dist/rhp-no-css-guard.css",
    "./posters.css": "./dist/posters.css"
  },
  "files": [
    "dist",
    "index.d.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node build.mjs",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  }
}
